# Server Configuration
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
LOG_LEVEL=INFO

# Supabase Credentials (PostgreSQL + pgvector)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# OpenAI API (Chat LLM & Embeddings)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Core Backend URL
BACKEND_API_URL=http://localhost:3000

# Google Maps Platform (Places API New, Routes API, Geocoding API)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
HOTEL_NAME="Grand Luxury Hotel Danang"
HOTEL_ADDRESS="28 Võ Nguyên Giáp, Phước Mỹ, Sơn Trà, Đà Nẵng, Việt Nam"
HOTEL_LAT=16.0645
HOTEL_LNG=108.2468

# CORS Whitelist (JSON array or comma-separated)

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
