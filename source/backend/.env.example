# Supabase
SUPABASE_URL=https://xrxuavdnwziskimidvhn.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Backend
PORT=3000
NODE_ENV=development
JWT_SECRET=your-jwt-secret-min-32-characters-long
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# AI Service
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_API_KEY=

# Chatbot Service (Gemini RAG)
CHATBOT_SERVICE_URL=http://localhost:8001

# Frontend URL
FRONTEND_URL=http://localhost:5173

# PayPal Sandbox (Checkout REST API v2)
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret
PAYPAL_API_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:5173/payment/callback/paypal
PAYPAL_CANCEL_URL=http://localhost:5173/payment/cancel

# VNPay Sandbox
# Đăng ký tại https://sandbox.vnpayment.vn để lấy TMN_CODE và HASH_SECRET
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/callback/vnpay
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# Email SMTP (Gmail)
# Hướng dẫn tạo Gmail App Password:
# 1. Truy cập https://myaccount.google.com/apppasswords
# 2. Tạo App Password cho Mail
# 3. Nhập email vào SMTP_USER và mật khẩu ứng dụng 16 ký tự vào SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="Hotel AI <your-email@gmail.com>"
